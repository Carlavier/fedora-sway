#!/bin/bash

bind '"\C-h": backward-kill-word'

PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

if [ -n "$SSH_CONNECTION" ] && [ -z "$TMUX" ] && command -v tmux &>/dev/null; then
	CLIENT_IP=$(echo "$SSH_CONNECTION" | awk '{print $1}')
	SESSION_NAME="ssh-${CLIENT_IP//[\.:]/-}"
	exec tmux new-session -A -s "$SESSION_NAME"
elif [ -n "$ALACRITTY_WINDOW_ID" ] && [ -z "$TMUX" ] && command -v tmux &>/dev/null; then
	tmux new-session -A -s main
fi

eval "$(zoxide init bash --cmd cd)"

if command -v thebleep >/dev/null 2>&1; then
    eval "$(thebleep --alias-loader fuck)"
fi

cbg() {
    local base="$HOME/.wallpaper"
    local name="$1"

    if [[ -z "$name" ]]; then
        echo "Usage: cbg <folder>"
        return 1
    fi

    if [[ "$name" == "ls" ]]; then
        for dir in "$base"/*/; do
            [[ -d "$dir" ]] || continue
            [[ "$(basename "$dir")" == .* || "$(basename "$dir")" == "using" ]] && continue
            basename "$dir"
        done
        return
    fi

    if [[ ! -d "$base/$name" || "$name" == "using" || "$name" == .* ]]; then
        echo "Invalid wallpaper folder: $name"
        return 1
    fi

    rm -rf "$base/using" >/dev/null 2>&1
    mkdir -p "$base/using" >/dev/null 2>&1 || return 1
    cp -a "$base/$name/." "$base/using/" >/dev/null 2>&1 || return 1
    if ! compgen -G "$base/using/blurred.*" > /dev/null; then
        magick "$base"/using/primary.* -blur 0x15 -brightness-contrast -20x0 "$base"/using/blurred.png
    fi

    swaymsg reload >/dev/null 2>&1
    swaymsg '[app_id="imv" title="filler[.]"] kill' >/dev/null 2>&1

    if [[ -f /tmp/portrait_manager.pid ]]; then
        kill "$(cat /tmp/portrait_manager.pid)" 2>/dev/null
    fi

    sleep 0.2

    setsid -f python3 "$HOME/.config/sway/portrait_manager.py" \
        >/dev/null 2>&1 </dev/null
}

_cbg_completion() {
    local base="$HOME/.wallpaper"
    local dir
    local folders=()

    for dir in "$base"/*/; do
        [[ -d "$dir" ]] || continue

        local folder
        folder="$(basename "$dir")"
        [[ "$folder" == .* || "$folder" == "using" ]] && continue

        folders+=("$folder")
    done

    COMPREPLY=( $(compgen -W "${folders[*]}" -- "${COMP_WORDS[COMP_CWORD]}") )
}

complete -F _cbg_completion cbg

stty -ixon
