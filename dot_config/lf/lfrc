set relativenumber
set number

map <space>e $stat "$f"
map <space>o $touch "new_file"

cmd trash %trash-put $fx

map . set hidden!

map Y $printf '%s' "$f" | wl-copy

map <a-r> reload

map q
cmd q quit

set previewer ~/.config/lf/preview.sh

cmd create %{{
    read -r path

    [ -z "$path" ] && exit 0

    ~/.config/lf/create.sh "$path"
}}

map o create

cmd make-exec %"$HOME/.config/lf/chmod_x.sh" + $fx
map x make-exec

cmd remove-exec %"$HOME/.config/lf/chmod_x.sh" - $fx
map X remove-exec

cmd cd %{{
    result="$(timeout 6 env -u SSH_CONNECTION -u ALACRITTY_WINDOW_ID setsid "$SHELL" -ic 'cd "$@" >/dev/null 2>&1 && pwd' lf "$@" </dev/null 2>/dev/null)"

    if [ -n "$result" ]; then
        result="$(printf '%s' "$result" | sed 's/\\/\\\\/g;s/"/\\"/g')"
        # lf -remote "send $id cd \"$result\""
        lf -remote "send $id builtin-cd \"$result\""
    else
        printf 'cd: no match: %s' "$*"
    fi
}}
